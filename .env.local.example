APP_NAME=TASYIIR
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Casablanca

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

# Local edition: one center on this PC, first-run wizard at /setup,
# no public signup and no platform back office.
TASYIIR_MODE=local

# Paste the public key printed by tools/license-issuer/keygen.php.
# Left empty, the build cannot verify licences and never expires.
TASYIIR_LICENSE_PUBLIC_KEY=

# Where database snapshots are written. The owner can change this in
# Settings → النسخ الاحتياطي (a second drive or a USB key is strongly advised).
# TASYIIR_BACKUP_PATH=D:\TASYIIR-Backups
TASYIIR_BACKUP_KEEP=30

# 127.0.0.1 = this PC only. 0.0.0.0 = other PCs in the center can reach
# http://<this-pc-ip>:8000 (open port 8000 in Windows Firewall first).
TASYIIR_HOST=127.0.0.1
TASYIIR_PORT=8000

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
